#!/bin/sh

# dmenu_run feeds this cache to a shell, so keep it private to the user.
umask 077
# PATH entries are directory names, not glob patterns.
set -f

cachedir="${XDG_CACHE_HOME:-"$HOME/.cache"}"
cache="$cachedir/dmenu_run"

mkdir -p "$cachedir" 2>/dev/null

IFS=:
if stest -dqr -n "$cache" $PATH; then
	# Write to a temporary file first: an interrupted update must not leave
	# a truncated cache that looks newer than the PATH directories.
	tmp="$cache.$$"
	trap 'rm -f "$tmp"' 0 1 2 15
	if stest -flx $PATH | sort -u > "$tmp"; then
		mv -f "$tmp" "$cache" 2>/dev/null && tmp=
	fi
	if [ -n "$tmp" ]; then
		cat "$tmp" 2>/dev/null || cat "$cache"
		rm -f "$tmp"
	else
		cat "$cache"
	fi
	trap - 0 1 2 15
else
	cat "$cache"
fi
