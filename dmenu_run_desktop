#!/bin/sh
# Pick a desktop application with dmenu and launch it by desktop entry ID.

cachedir="${XDG_CACHE_HOME:-$HOME/.cache}"
log="$cachedir/dmenu_run_desktop.log"

# Report a failure on stderr and, when possible, as a desktop notification
# (a keybinding has no terminal, so a failure would otherwise be invisible).
fail() {
	echo "dmenu_run_desktop: $*" >&2
	command -v notify-send >/dev/null 2>&1 &&
		notify-send -a dmenu_run_desktop dmenu_run_desktop "$*" &
	exit 1
}

# dmenu needs a UTF-8 locale for its input method and for non-ASCII text
# (e.g. Nerd Font icons). If the session has none, give one to dmenu alone:
# exporting it would change the language of every application we launch.
run_dmenu() {
	case ${LC_ALL:-${LC_CTYPE:-$LANG}} in
	*[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) dmenu "$@" ;;
	*) LC_ALL=C.UTF-8 dmenu "$@" ;;
	esac
}

# Prefer the dmenu_path_desktop installed next to this script, so a minimal
# PATH (for example right after login) does not matter. Fall back to PATH.
path_cmd=dmenu_path_desktop
case $0 in
*/*) [ -x "${0%/*}/dmenu_path_desktop" ] && path_cmd=${0%/*}/dmenu_path_desktop ;;
esac

pick() {
	"$path_cmd" | run_dmenu "$@"
}

if [ -t 2 ]; then
	selection=$(pick "$@")
else
	# Started from a keybinding: there is no terminal, so keep the errors of
	# dmenu and the list builder in a log (rewritten on every run).
	errlog=/dev/null
	mkdir -p "$cachedir" 2>/dev/null
	( : > "$log" ) 2>/dev/null && errlog=$log
	selection=$(pick "$@" 2>"$errlog")
fi

[ -n "$selection" ] || exit 0 # Escape, or nothing typed

# a typed value such as "-h" would otherwise be taken as an option
case $selection in
-*) fail "not a desktop entry: '$selection'" ;;
esac

command -v gtk-launch >/dev/null 2>&1 || fail "gtk-launch not found"

# stdin from /dev/null so the application does not hold on to ours
gtk-launch "$selection" < /dev/null || fail "could not launch '$selection'"
